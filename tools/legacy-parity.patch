+use super::config;
+use crate::render::{
+    CpuClock, Frame, Frustum, RenderCpuTimings, RenderStage, Renderer, gpu_profile,
+};
+
+impl Renderer {
+    pub(in crate::render) fn render_parity(
+        &mut self,
+        frame: &Frame,
+        time: f32,
+    ) -> RenderCpuTimings {
+        let mut cpu = CpuClock::new();
+        let (matrix, eye) = config::camera();
+        let mut camera = frame.camera;
+        camera.pos = eye;
+        self.uniforms.write(
+            &self.gpu,
+            frame,
+            matrix,
+            matrix,
+            matrix,
+            time,
+            &self.shadow,
+            self.scene.extent(),
+        );
+        let frustum = Frustum::from_view_proj(matrix);
+        cpu.lap(RenderStage::Prepare);
+        let mut encoder = self.gpu.encoder();
+        let mut profiler = self.profiler.take();
+        let query = gpu_profile::begin(profiler.as_ref(), &mut encoder, "frame");
+        self.encode_opaque(&mut encoder, camera, &frustum, None, profiler.as_ref());
+        gpu_profile::end(profiler.as_ref(), &mut encoder, query);
+        if let Some(p) = &mut profiler {
+            p.resolve_queries(&mut encoder);
+        }
+        cpu.lap(RenderStage::Encode);
+        self.scene.submit(&self.gpu.queue, [encoder.finish()]);
+        self.scene.finish_frame(&self.gpu.queue);
+        cpu.lap(RenderStage::Submit);
+        if let Some(mut p) = profiler {
+            p.end_frame().expect("parity profiling complete");
+            self.profiler = Some(p);
+        }
+        let _ = self.gpu.device.poll(wgpu::PollType::Poll);
+        cpu.lap(RenderStage::Poll);
+        cpu.finish()
+    }
+
+    pub fn capture_parity_depth(&self, path: &std::path::Path) -> std::io::Result<()> {
+        let texture = self.targets.depth.texture();
+        let width = texture.width();
+        let height = texture.height();
+        let stride = (width * 4).div_ceil(256) * 256;
+        let buffer = self.gpu.device.create_buffer(&wgpu::BufferDescriptor {
+            label: Some("parity depth capture"),
+            size: stride as u64 * height as u64,
+            usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+            mapped_at_creation: false,
+        });
+        let mut encoder = self.gpu.encoder();
+        let mut source = texture.as_image_copy();
+        source.aspect = wgpu::TextureAspect::DepthOnly;
+        encoder.copy_texture_to_buffer(
+            source,
+            wgpu::TexelCopyBufferInfo {
+                buffer: &buffer,
+                layout: wgpu::TexelCopyBufferLayout {
+                    offset: 0,
+                    bytes_per_row: Some(stride),
+                    rows_per_image: None,
+                },
+            },
+            texture.size(),
+        );
+        self.gpu.queue.submit([encoder.finish()]);
+        let (tx, rx) = std::sync::mpsc::channel();
+        buffer.map_async(wgpu::MapMode::Read, .., move |result| {
+            let _ = tx.send(result);
+        });
+        self.gpu
+            .device
+            .poll(wgpu::PollType::wait_indefinitely())
+            .map_err(std::io::Error::other)?;
+        rx.recv()
+            .map_err(std::io::Error::other)?
+            .map_err(std::io::Error::other)?;
+        let data = buffer.get_mapped_range(..).map_err(std::io::Error::other)?;
+        let pixels: Vec<_> = data
+            .chunks_exact(stride as usize)
+            .flat_map(|row| row[..width as usize * 4].iter().copied())
+            .collect();
+        std::fs::write(path, pixels)
+    }
+}
