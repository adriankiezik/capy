+use glam::{Mat4, Vec3};
+use std::sync::OnceLock;
+
+pub(super) fn camera() -> (Mat4, Vec3) {
+    static CAMERA: OnceLock<(Mat4, Vec3)> = OnceLock::new();
+    *CAMERA.get_or_init(|| {
+        let path =
+            std::env::var_os("BENCH_PARITY_CAMERA").expect("BENCH_PARITY_CAMERA is required");
+        let data = std::fs::read(path).expect("read shared camera");
+        assert_eq!(data.len(), 76);
+        let values: Vec<f32> = data
+            .chunks_exact(4)
+            .map(|v| f32::from_le_bytes(v.try_into().unwrap()))
+            .collect();
+        (
+            Mat4::from_cols_array(values[..16].try_into().unwrap()),
+            Vec3::from_slice(&values[16..]),
+        )
+    })
+}
+
+pub(in crate::render) fn shader(source: &str) -> String {
+    let source = source.replace(
+        "out.pos = g.view_proj * obj.model * vec4<f32>(vertex.xyz, 1.0);",
+        "out.pos = g.view_proj * (obj.model * vec4<f32>(vertex.xyz, 1.0));",
+    );
+    let Some(start) = source.find("fn shade_hit(") else {
+        return source.to_owned();
+    };
+    let opening = start + source[start..].find('{').unwrap();
+    let mut depth = 1;
+    let mut end = opening + 1;
+    for (offset, byte) in source[opening + 1..].bytes().enumerate() {
+        match byte {
+            b'{' => depth += 1,
+            b'}' => depth -= 1,
+            _ => {}
+        }
+        if depth == 0 {
+            end = opening + offset + 2;
+            break;
+        }
+    }
+    let body = r#"{
+    if tr.mat == 0u { discard; }
+    let position = obj.model * vec4<f32>(tr.p_obj, 1.0);
+    let clip = g.view_proj * position;
+    if clip_proxy_hit && clip.z > clip.w { discard; }
+    var color = vec3<f32>(1.0, 0.0, 1.0);
+    switch tr.mat {
+        case 8u: { color = vec3<f32>(0.63, 0.66, 0.69); }
+        case 3u: { color = vec3<f32>(0.51, 0.25, 0.17); }
+        case 12u: { color = vec3<f32>(0.55, 0.52, 0.46); }
+        case 20u: { color = vec3<f32>(0.18, 0.19, 0.21); }
+        default: {}
+    }
+    return FsOut(vec4<f32>(color, 1.0), clip.z / clip.w);
+}"#;
+    format!("{}{}{}", &source[..opening], body, &source[end..])
+}
